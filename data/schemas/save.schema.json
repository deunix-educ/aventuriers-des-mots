{
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "school_level",
    "session_count",
    "unlocked_regions",
    "skills",
    "rewards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "school_level": { "type": "string", "enum": ["CE1", "CE2"] },
    "session_count": { "type": "integer", "minimum": 0 },
    "unlocked_regions": { "type": "array", "items": { "type": "string" } },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "recent_results",
          "recent_hint_used",
          "sessions_succeeded",
          "formats_succeeded",
          "last_session_practiced",
          "review_interval_index",
          "next_review_session"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["decouverte", "en_acquisition", "en_consolidation", "acquise", "a_reviser"]
          },
          "recent_results": { "type": "array", "items": { "type": "boolean" } },
          "recent_hint_used": { "type": "array", "items": { "type": "boolean" } },
          "sessions_succeeded": { "type": "array", "items": { "type": "integer" } },
          "formats_succeeded": { "type": "array", "items": { "type": "string" } },
          "last_session_practiced": { "type": "integer" },
          "review_interval_index": { "type": "integer" },
          "next_review_session": { "type": "integer" }
        }
      }
    },
    "rewards": {
      "type": "object",
      "required": ["stars", "items"],
      "additionalProperties": false,
      "properties": {
        "stars": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
