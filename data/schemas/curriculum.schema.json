{
  "type": "object",
  "required": [
    "level",
    "region_id",
    "chapter_id",
    "title",
    "rule_ids",
    "review_status"
  ],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "string", "enum": ["CE1", "CE2", "CM1", "CM2"] },
    "region_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "chapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string", "minLength": 1 },
    "region_title": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1, "maximum": 3 },
    "backdrop": { "type": "string", "enum": ["forest", "marsh", "beach", "mountain", "desert", "island", "castle", "village", "jungle", "space", "volcano", "library"] },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "review_status": { "type": "string", "enum": ["draft", "validated"] }
  }
}
