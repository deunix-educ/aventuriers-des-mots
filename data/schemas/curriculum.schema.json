{
  "type": "object",
  "required": [
    "level",
    "region_id",
    "chapter_id",
    "title",
    "rule_ids",
    "review_status"
  ],
  "additionalProperties": false,
  "properties": {
    "level": { "type": "string", "enum": ["CE1", "CE2"] },
    "region_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "chapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "title": { "type": "string", "minLength": 1 },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "review_status": { "type": "string", "enum": ["draft", "validated"] }
  }
}
