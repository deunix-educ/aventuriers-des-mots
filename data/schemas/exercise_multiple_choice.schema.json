{
  "type": "object",
  "required": [
    "id",
    "level",
    "domain",
    "skill",
    "rule_id",
    "difficulty",
    "type",
    "instruction",
    "question",
    "answers",
    "correct_answer",
    "hint",
    "explanation",
    "review_tags",
    "review_status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "level": { "type": "string", "enum": ["CE1", "CE2"] },
    "domain": { "type": "string", "enum": ["grammaire", "orthographe"] },
    "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "type": { "type": "string", "const": "multiple_choice" },
    "instruction": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "answers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "correct_answer": { "type": "integer", "minimum": 0 },
    "hint": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1 },
    "review_tags": { "type": "array", "items": { "type": "string" } },
    "review_status": { "type": "string", "enum": ["draft", "validated"] }
  }
}
