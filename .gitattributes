# Texte : fins de ligne normalisees en LF
* text=auto eol=lf

*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Assets : binaires, jamais de conversion de fin de ligne
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.ico binary
*.svg binary
